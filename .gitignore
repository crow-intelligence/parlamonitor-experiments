# Source literature — ground truth for the methods, never version controlled
papers/

# Raw exports. 32 MB and regenerable from the parlamonitor SQLite DB with
# `backend/export_nlp_datasets.py --period 43`; data/raw/README.md says not to
# commit them. The manifest and the README are committed instead — they are
# the provenance record and they are small.
data/raw/*.jsonl

# The parentheticals exports, same policy: 12 MB of raw text, regenerable, and
# the provenance that matters (sha256 per file, line and word counts) is
# recorded in data/derived/parentheticals/manifest.json instead.
data/raw/parantheticals/

# Derived data is rebuildable; anything hand-verified belongs in git, so add
# an exception for it rather than widening this.
data/derived/
exports/

# Lexicons. Putz Orsolya's emotion dictionaries are her ongoing work, used
# with permission and explicitly not redistributable. The Precognox sentiment
# lexicon has a licence conflict upstream (the listing says CC BY-SA, the
# dataset page CC BY-NC 4.0) and stays out until that is settled. The
# provenance record in data/lexicons/README.md is committed in their place.
data/lexicons/**/*.txt

# The dashboard's data bundle is derived from data/derived and rebuilt in a
# second by scripts/build_dashboard_data.py. The page that reads it is in git.
dashboard/data/

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Test artifacts
.coverage
.hypothesis/

# Jupyter checkpoints
.ipynb_checkpoints/

# Local harness / session state
.claude/
